# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Banco (MongoDB — Atlas: mongodb+srv://usuario:senha@cluster.xxxx.mongodb.net)
MONGODB_URI=mongodb://localhost:27017
# Nome do banco (padrão: ravox)
MONGODB_DB=ravox

# Autenticação do painel (gere com: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare R2 (R2 > Manage API tokens, permissão Object Read & Write)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ravox-projects
# Domínio público do bucket (custom domain ou https://pub-xxxx.r2.dev)
R2_PUBLIC_URL=
# Opcional: endpoint S3 alternativo (ex: MinIO local em http://localhost:9000)
# R2_ENDPOINT=
